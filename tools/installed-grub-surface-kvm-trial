#!/bin/sh

# One-shot KVM trial entry for the installed Surface system.
# Arm the known-good Ready entry before the handoff.  The fallback service
# clears it only after an EL2 boot reaches network-online.target; an early
# reset therefore returns to Ready exactly once.
cat <<'GRUB_ENTRY'
menuentry 'Proxmox VE - Surface Laptop 13 (KVM trial; fallback to ready)' --id surface-el2-kvm-trial --class debian --class gnu-linux --class gnu --class os {
    insmod part_gpt
    insmod fat
    insmod chain
    search --no-floppy --fs-uuid --set=esp 584B-B4D4
    set next_entry=surface-el1-ready
    save_env next_entry
    chainloader ($esp)/EFI/BOOT/surface-kvm-entry.efi
    boot
}
GRUB_ENTRY
