[Unit]
Description=Clear the one-shot Surface EL2 fallback after a healthy KVM boot
ConditionKernelCommandLine=id_aa64mmfr0.ecv=1
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/surface-kvm-clear-fallback
RemainAfterExit=yes

[Install]
WantedBy=network-online.target
