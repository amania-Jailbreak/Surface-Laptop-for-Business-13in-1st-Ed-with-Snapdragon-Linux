--- a/src/bounce_main.c
+++ b/src/bounce_main.c
@@ -82,11 +82,17 @@
 	EFI_STATUS status = uefi_call_wrapper(real_GetMemoryMap, 5,
 			MemoryMapSize, MemoryMap, MapKey, DescriptorSize, DescriptorVersion);
 
-	if (MemoryMapSize)
+	/*
+	 * EFI_BUFFER_TOO_SMALL reports the required size, not the size of the
+	 * caller's buffer.  Remembering that value together with a NULL or short
+	 * buffer makes the ExitBootServices hook walk beyond valid memory.
+	 */
+	if (!EFI_ERROR(status) && MemoryMap && MemoryMapSize && DescriptorSize &&
+	    *DescriptorSize) {
 		LastMemoryMapSize = *MemoryMapSize;
-	if (DescriptorSize)
 		LastDescriptorSize = *DescriptorSize;
-	LastMemoryMap = MemoryMap;
+		LastMemoryMap = MemoryMap;
+	}
 
 	return status;
 }
@@ -99,37 +105,34 @@
 		return uefi_call_wrapper(real_ExitBootServices, 2, ImageHandle, MapKey);
 
 	/*
-	 * Unfortunately switching to EL2 will corrupt the caches and
-	 * the memory will be gone if it was not flushed to ram. Since
-	 * the OS loaders generally assume EBS won't break caches, we
-	 * have to flush and invalidate everything to make sure loader
-	 * doesn't break.
-	 *
-	 * We can't possibly know which memory was touched by the loader
-	 * so we just flush everything that was allocated here. This
-	 * is suboptimal but would hopefully make sure we don't crash.
-	 *
-	 * Note that if we try to flush caches on hyp-owned memory, we
-	 * will also crash. Thus we perform AUTH command after we flushed
-	 * all the cache.
+	 * X1P42100 firmware resets when dc civac is issued for some ordinary
+	 * EfiBootServicesData ranges.  The upstream all-types sweep therefore
+	 * cannot be used here.  The OS loader itself is still required to have
+	 * its instruction/data ranges made visible before Secure Launch changes
+	 * the execution context.  slbounce is itself a runtime EFI driver, so
+	 * include runtime code/data as well.  In particular, do not touch
+	 * BootServicesCode/Data or ACPI ranges.
 	 */
 
 	EFI_MEMORY_DESCRIPTOR *MemoryEntry;
-	for (int i = 0; i < LastMemoryMapSize / LastDescriptorSize; ++i) {
-		MemoryEntry = (EFI_MEMORY_DESCRIPTOR*)((UINT8*)LastMemoryMap + LastDescriptorSize * i);
-		uint64_t start = MemoryEntry->PhysicalStart;
-		uint64_t size  = MemoryEntry->NumberOfPages * 4096;
-
-		switch (MemoryEntry->Type) {
-		case EfiLoaderCode:
-		case EfiLoaderData:
-		case EfiBootServicesCode:
-		case EfiBootServicesData:
-		case EfiRuntimeServicesCode:
-		case EfiRuntimeServicesData:
-		case EfiACPIReclaimMemory:
-			clear_dcache_range(start, size);
-			break;
+	if (LastMemoryMap && LastDescriptorSize >= sizeof(EFI_MEMORY_DESCRIPTOR) &&
+	    LastMemoryMapSize >= sizeof(EFI_MEMORY_DESCRIPTOR)) {
+		for (UINTN offset = 0;
+		     offset <= LastMemoryMapSize - sizeof(EFI_MEMORY_DESCRIPTOR);
+		     offset += LastDescriptorSize) {
+			MemoryEntry = (EFI_MEMORY_DESCRIPTOR *)((UINT8 *)LastMemoryMap + offset);
+			if ((MemoryEntry->Type == EfiLoaderCode ||
+			     MemoryEntry->Type == EfiLoaderData ||
+			     MemoryEntry->Type == EfiRuntimeServicesCode ||
+			     MemoryEntry->Type == EfiRuntimeServicesData) &&
+			    MemoryEntry->NumberOfPages <= UINT64_MAX / 4096) {
+				uint64_t start = MemoryEntry->PhysicalStart;
+				uint64_t size = MemoryEntry->NumberOfPages * 4096;
+				if (start <= UINT64_MAX - size)
+					clear_dcache_range(start, size);
+			}
+			if (LastMemoryMapSize - offset < LastDescriptorSize)
+				break;
 		}
 	}
 
@@ -229,6 +232,7 @@
 	}
 
 	Print(L"===[ slbounce ]==================================\n");
+	Print(L" surface-x1p: safe ExitBootServices cache mode\n");
 	Print(L" BS->ExitBootServices() was replaced with a hook\n");
 	Print(L"  that would perform Secure-Launch right after\n");
 	Print(L"exiting UEFI. Your system will crash if SL fails.\n");
